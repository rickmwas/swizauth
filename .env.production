# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Database Configuration
POSTGRES_DB=TSAUTH
POSTGRES_USER=TSAUTH_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_PORT=6379

# Service Ports
AUTH_SERVICE_PORT=8080
ADMIN_SERVICE_PORT=3001
DASHBOARD_PORT=3000

# Security Secrets (Generate these with strong random values)
INTERNAL_API_SECRET=7f5f227c969e7acc6ced1e4177bcb490e0cc9600eafa42ccead908069538d379
MFA_ENCRYPTION_KEY=df1219cbd075e893338dab3a5db79738905a8748c971f2a3c5a4eadfad373538
SESSION_SECRET=0cf4aae6ba4d2526844bad05bda5c14ea0487a1b13c37e9d959ba5ebfcb26989

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Frontend URLs (Update with your actual domain)
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth.yourdomain.com
NEXT_PUBLIC_ADMIN_SERVICE_URL=https://api.yourdomain.com

# Cookie Configuration
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true