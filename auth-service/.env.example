# Server Configuration
PORT=8080
ENV=development
LOG_LEVEL=debug

# CORS Whitelist (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Databases
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tsauth?sslmode=disable
REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Cryptography & JWT Settings
JWT_PRIVATE_KEY_PATH=certs/private.pem
JWT_PUBLIC_KEY_PATH=certs/public.pem
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# Multi-Factor Authentication (MFA) Settings
# 32-byte hex key for AES-256-GCM encryption
MFA_ENCRYPTION_KEY=

# Service-to-service internal API auth
INTERNAL_API_SECRET=

# SMTP / Email Configuration (e.g. for Supabase SMTP integration)
# If SMTP_HOST is blank, it falls back to console logging in development mode
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER=noreply@example.com


