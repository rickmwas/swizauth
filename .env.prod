# Production Environment Configuration
# Copy this file to .env.production and fill in your actual values

# Database Configuration
POSTGRES_DB=TSAUTH
POSTGRES_USER=TSAUTH_user
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_PORT=6379

# Service Ports
AUTH_SERVICE_PORT=8080
ADMIN_SERVICE_PORT=3001
DASHBOARD_PORT=3000

# Security Secrets (Generate these with strong random values)
INTERNAL_API_SECRET=your_internal_api_secret_32_chars_min
MFA_ENCRYPTION_KEY=your_mfa_encryption_key_64_chars_hex
SESSION_SECRET=your_session_secret_32_chars_min

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Frontend URLs (Update with your actual domain)
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth.yourdomain.com
NEXT_PUBLIC_ADMIN_SERVICE_URL=https://api.yourdomain.com

# Cookie Configuration
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true